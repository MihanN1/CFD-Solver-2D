#pragma once

// Generated by CMake from include/VersionGenerated.hpp.in into the build
// directory. Nothing includes this file directly - include/Version.hpp does,
// and supplies stand-in values when it is not there yet, which is what keeps
// an editor's IntelliSense from painting every CFD_* macro red before the
// first configure has run.

// The full project version, "major.minor.patch".
#define CFD_APP_VERSION "@PROJECT_VERSION@"

// What the release is actually called: "0.2", not "0.2.0". Archive names, the
// release folder and the git tag all use this short form, so the update check
// has to compare against the same thing.
#define CFD_RELEASE_VERSION "@CFD_RELEASE_VERSION@"

#define CFD_APP_NAME "@CFD_APP_NAME@"
#define CFD_REPO_OWNER "@CFD_REPO_OWNER@"
#define CFD_REPO_NAME "@CFD_REPO_NAME@"

// Where a newer release lives, and where the check asks about it.
#define CFD_RELEASES_URL \
    "https://github.com/" CFD_REPO_OWNER "/" CFD_REPO_NAME "/releases"
#define CFD_RELEASES_API \
    "https://api.github.com/repos/" CFD_REPO_OWNER "/" CFD_REPO_NAME "/releases"

// Which of the three accelerators this binary was actually compiled with. The
// runtime switches in Runtime.hpp can only turn off what is here; they cannot
// turn on something the compiler never emitted.
#cmakedefine01 CFD_BUILT_WITH_CUDA
#cmakedefine01 CFD_BUILT_WITH_OPENMP
#cmakedefine01 CFD_BUILT_WITH_AVX2

// The feature tag of this build - "avx2-omp-cuda" down to "plain" - the same
// string the release archives and the installers are indexed by.
#define CFD_BUILD_FEATURES "@CFD_BUILD_FEATURES@"

// Two markers meant to be found by reading the executable rather than running
// it. The UI has to know which solver it is pointed at before it launches
// anything - whether continuation arguments exist, whether the runtime
// switches exist, whether CUDA is in there - and it used to answer that by
// looking for the file name "Fluid Solver.exe" and grepping for the name of a
// source file. That said nothing on Linux and macOS, where the solver has no
// extension, so the UI refused to run a perfectly good build.
//
// These are single literals, so they survive into the binary intact and can be
// found with a plain byte search. "--version" prints them as well, for anyone
// who would rather ask than grep.
#define CFD_VERSION_MARKER "FluidSolverVersion=" CFD_RELEASE_VERSION
#define CFD_FEATURES_MARKER "FluidSolverFeatures=" CFD_BUILD_FEATURES
