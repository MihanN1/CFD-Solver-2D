#pragma once

// Generated by CMake from include/Version.hpp.in. Everything that has to know
// which release this binary is - the update check, the tray tooltip, the
// Windows version block - reads it from here rather than from a literal pasted
// into three files that then drift apart.

// The full project version, "major.minor.patch".
#define CFD_APP_VERSION "@PROJECT_VERSION@"

// What the release is actually called: "0.2", not "0.2.0". Archive names, the
// release folder and the git tag all use this short form, so the update check
// has to compare against the same thing.
#define CFD_RELEASE_VERSION "@CFD_RELEASE_VERSION@"

#define CFD_APP_NAME "@CFD_APP_NAME@"
#define CFD_REPO_OWNER "@CFD_REPO_OWNER@"
#define CFD_REPO_NAME "@CFD_REPO_NAME@"

// Where a newer release lives, and where the check asks about it.
#define CFD_RELEASES_URL \
    "https://github.com/" CFD_REPO_OWNER "/" CFD_REPO_NAME "/releases"
#define CFD_RELEASES_API \
    "https://api.github.com/repos/" CFD_REPO_OWNER "/" CFD_REPO_NAME "/releases"

// Which of the three accelerators this binary was actually compiled with. The
// runtime switches in Runtime.hpp can only turn off what is here; they cannot
// turn on something the compiler never emitted.
#cmakedefine01 CFD_BUILT_WITH_CUDA
#cmakedefine01 CFD_BUILT_WITH_OPENMP
#cmakedefine01 CFD_BUILT_WITH_AVX2

// The feature tag of this build - "avx2-omp-cuda" down to "plain" - the same
// string the release archives and the installers are indexed by.
#define CFD_BUILD_FEATURES "@CFD_BUILD_FEATURES@"
